rules_version = '2';

// Product photos (catalog/) and campaign images (campaign/) are public, because they appear on the website.
// Only the owner (a uid in /admins, the same people who can edit the website) can upload, and only images.
service firebase.storage {
  match /b/{bucket}/o {
    function isEditor() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Product photos (up to 5 MB) and short product videos (MP4, WebM or MOV, up to 50 MB).
    match /catalog/{productId}/{file} {
      allow read: if true;
      allow create: if isEditor() && (
        (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'))
        || (request.resource.size < 50 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|webm|quicktime)')));
      allow update, delete: if false;
    }

    match /campaign/{file} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    // Website photos chosen in Admin → Website: hero, category cards, the closing banner, the About page.
    match /site/{file} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    // The shop's logo. Small raster images only (no SVG, which can carry scripts).
    match /brand/{file} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|webp|jpeg)');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
